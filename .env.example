PORT=3001

# Postgres connection string (Supabase or any Postgres instance)
DATABASE_URL=

# Supabase project settings (used for storage bucket sync & client config endpoint)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (transactional email for signup verification codes), sent via SMTP using
# Nodemailer. Configured for Brevo's SMTP relay by default, but any SMTP provider
# works (Gmail, Outlook, Amazon SES, etc). Get SMTP_USER/SMTP_PASS from your Brevo
# account under Settings -> SMTP & API -> SMTP. EMAIL_FROM must be an address you
# have verified as a "Sender" in Brevo (Senders, Domains & Dedicated IPs -> Senders)
# before Brevo will allow sending from it.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SocietyOne <no-reply@yourdomain.com>

# Comma-separated list of origins allowed to call this API (the frontend's URL)
CORS_ORIGIN=http://localhost:5173

# One-time secret for POST /api/admin/migrate-users-to-auth (migrates existing
# society_users rows into Supabase Auth). Set this, run the migration once via
# the x-migration-secret header, then remove it — not needed afterward.
MIGRATION_SECRET=

# Firebase Cloud Messaging — sends push notifications to the Android app
# when a notice or event is created (see services/pushNotifications.ts).
# Optional: if left unset, notices/events still save normally, they just
# won't push a notification to any device. Get this from the Firebase
# Console: Project Settings -> Service Accounts -> Generate new private key.
# That downloads a JSON file — paste its ENTIRE contents here as a single
# line (most hosts let you paste multi-line JSON directly into one env var).
FIREBASE_SERVICE_ACCOUNT_JSON=
